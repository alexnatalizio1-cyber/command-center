# Google OAuth (Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret_run_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# OpenWeatherMap (free tier at openweathermap.org)
NEXT_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key
NEXT_PUBLIC_WEATHER_CITY=New York

# --- Gemini: REQUIRED ---
# Used by Weekly Digest, the Market Research "why now" enrichment, AND the
# web-only research mode. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- Blancco Market Research Agent ---
# Apollo API key: OPTIONAL. If set, the agent uses Blancco's Apollo workspace
# for richer signals (headcount trend, blancco.com intent, CRM status). If NOT
# set, the agent automatically runs in web-only mode using GEMINI_API_KEY
# (lower signal depth — the email/Sheet flag this honestly). Apollo API keys
# are workspace-admin controlled.
APOLLO_API_KEY=

# Comma-separated SDR recipients for the daily email.
MARKET_RESEARCH_RECIPIENTS=sdr-team@yourcompany.com,manager@yourcompany.com

# Shared secret the GitHub Actions cron sends as a Bearer token to authorize
# the daily run. Generate with: openssl rand -hex 32
MARKET_RESEARCH_CRON_SECRET=your_random_cron_secret

# Optional: pin the history Google Sheet by ID. If unset, the agent finds or
# creates a sheet named "Blancco Market Research Log" in the sending account's
# Drive automatically.
MARKET_RESEARCH_SHEET_ID=

# Refresh token for the mailbox that SENDS the daily email and OWNS the history
# Sheet. Minted once for that mailbox against GOOGLE_CLIENT_ID/SECRET with
# gmail.send + spreadsheets + drive scopes (see OAuth Playground steps in the
# GitHub Actions workflow comments). Required for unattended runs.
GOOGLE_REFRESH_TOKEN=your_sending_mailbox_refresh_token

# Public base URL the cron should call (e.g. https://your-app.vercel.app).
MARKET_RESEARCH_APP_URL=https://your-deployed-app-url
